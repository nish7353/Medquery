# Copy to .env (project root) and adjust. Never commit .env.
# All variables are optional; the defaults below are what the app uses.

# --- General ---------------------------------------------------------------
MEDQUERY_ENVIRONMENT=development
MEDQUERY_LOG_LEVEL=INFO
# JSON list of allowed browser origins (only needed if the frontend is served elsewhere)
MEDQUERY_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# --- Request limits ------------------------------------------------------------
MEDQUERY_MIN_QUESTION_CHARS=3
MEDQUERY_MAX_QUESTION_CHARS=500
MEDQUERY_MAX_REQUEST_BYTES=8192

# --- BERT query understanding ----------------------------------------------------
# Any BERT-family encoder from the Hugging Face Hub, or a local directory.
# Biomedical alternatives: dmis-lab/biobert-base-cased-v1.1,
#   microsoft/BiomedNLP-BiomedBERT-base-uncased-abstract-fulltext
MEDQUERY_QUERY_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MEDQUERY_QUERY_MAX_TOKENS=128
# true = load models in the background at startup instead of on first query
MEDQUERY_PRELOAD_MODELS=false
# true = use only locally cached model weights (no downloads)
MEDQUERY_HF_OFFLINE=false

# --- Knowledge base (connect YOUR knowledge base here) ---------------------------
# "package.module:ClassName" of your Retriever implementation. Empty = not configured.
# Built-in knowledge base (build it first: python -m knowledge.build all):
#   MEDQUERY_KB_ADAPTER=retrieval.adapters.medquery_kb:MedQueryKnowledgeBase
MEDQUERY_KB_ADAPTER=
# Passed to your adapter's constructor (file path, database URL, index name, ...)
MEDQUERY_KB_CONNECTION=
MEDQUERY_KB_TOP_K=5
MEDQUERY_KB_TIMEOUT_SECONDS=10
MEDQUERY_KB_MIN_RELEVANCE=0.0

# --- Answer processing -------------------------------------------------------------
# extractive    = BERT QA model picks an answer span from retrieved passages
# evidence_only = no answer extraction; show ranked passages only
MEDQUERY_ANSWER_MODE=extractive
MEDQUERY_QA_MODEL_NAME=ktrapeznikov/biobert_v1.1_pubmed_squad_v2
MEDQUERY_QA_MIN_CONFIDENCE=0.15
MEDQUERY_QA_MAX_ANSWER_TOKENS=64

# --- Multilingual voice and text (Sarvam AI) --------------------------------------
# Needed for Hindi, Kannada, Tamil and Telugu, voice questions and "Listen to answer".
# Get a key at https://dashboard.sarvam.ai (API Keys). Put the real key only in .env,
# which is git-ignored, never in this file. Leave empty for English only.
SARVAM_API_KEY=
# Models checked against docs.sarvam.ai (October 2026); change only if Sarvam retires them.
MEDQUERY_SARVAM_STT_MODEL=saaras:v4
MEDQUERY_SARVAM_TRANSLATE_MODEL=mayura:v1
MEDQUERY_SARVAM_TTS_MODEL=bulbul:v3
# A bulbul:v3 voice such as shubh, ritu, priya, kavya; empty = Sarvam's default.
MEDQUERY_SARVAM_TTS_SPEAKER=
MEDQUERY_SARVAM_TIMEOUT_SECONDS=20

# --- Persistence -----------------------------------------------------------------
# MEDQUERY_DATABASE_PATH=backend/data/medquery.sqlite3
MEDQUERY_HISTORY_LIMIT=50
